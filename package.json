{
  "name": "hhs-core",
  "private": true,
  "workspaces": [
    "apps/*",
    "apps/mission-control/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:mission-dash",
    "dev:mission-api": "npm run dev -w @hhs/mission-api",
    "dev:mission-dash": "npm run build -w @hhs/mission-dashboard",
    "build:mission-api": "npm run build -w @hhs/mission-api",
    "build:mission-dash": "npm run build -w @hhs/mission-dashboard",
    "typecheck": "npm run typecheck -w @hhs/mission-dashboard && npm run typecheck -w @hhs/agent-core && npm run typecheck -w @hhs/command-gateway",
    "test": "npm test -w @hhs/mission-api && npm test -w @hhs/command-gateway",
    "lint": "npm run lint -w @hhs/mission-dashboard",
    "dev:command-gateway": "npm run dev -w @hhs/command-gateway"
  }
}
