# Mission Control API (Express, http://localhost:3001)

# --- Postgres ---
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=hhs
PGPASSWORD=your-password
PGDATABASE=mission_control

# --- Auth ---
# Secret used to verify Supabase access-token JWTs on protected endpoints.
# Find it in Supabase Dashboard -> Settings -> API -> JWT Secret.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Set to "true" to allow self-registration via POST /api/auth/register
# ALLOW_OPEN_REGISTRATION=true

# --- Twilio (optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Server ---
PORT=3001
# UPLOAD_DIR=./uploads
